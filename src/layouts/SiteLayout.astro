---
const { title = '' } = Astro.props;
---
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} |` : ''} kimbyeonggwan</title>
    <style>
      :root{
        --bg:#000000; /* 🔥 배경색 통일 */
        --fg:#ECECEC;
        --fg-dim:#9aa3b4;
        --accent:#da6767;
        --card:#101317;
        --bd:#1e232c;
      }
      html,body{
        margin:0;
        background:var(--bg);
        color:var(--fg);
        font-family:Pretendard,"Noto Sans KR",system-ui,-apple-system,"Segoe UI",
        Roboto,Helvetica,Arial,"Apple SD Gothic Neo","Noto Sans","Malgun Gothic",sans-serif;
      }
      a{color:inherit;text-decoration:none}

      .top{
        display:flex;
        align-items:center;
        justify-content:center;
        gap:38px;
        max-width:1080px;
        margin:14px auto 0;
        padding:0 16px;
        color:#cfd6e4;
      }
      .tabs{
        display:flex;
        gap:36px;
        font-weight:700;
        font-size:20px;
      }
      .tab{opacity:.65;transition:opacity .15s}
      .tab:hover{opacity:.9}
      .tab[aria-current="page"]{
        opacity:1;
        border-bottom:3px solid var(--accent);
        padding-bottom:6px;
      }

      .main{
        max-width:1080px;
        margin:28px auto 64px;
        padding:0 16px;
      }
    </style>
  </head>

  <body>
    <header class="top">
      <nav class="tabs">
        <a class="tab" href="/intro" aria-current={Astro.url.pathname==="/" ? "page": undefined}>intro</a>
        <a class="tab" href="/series" aria-current={Astro.url.pathname.startsWith("/series") ? "page": undefined}>Series</a>
        <a class="tab" href="/contact" aria-current={Astro.url.pathname.startsWith("/contact") ? "page": undefined}>Contact</a>
      </nav>
    </header>

    <main class="main">
      <slot />
    </main>
  </body>
</html>
