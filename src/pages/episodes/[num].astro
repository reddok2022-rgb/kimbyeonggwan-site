---
// src/pages/episodes/[num].astro
import EpisodeLayout from '../../layouts/EpisodeLayout.astro';

export async function getStaticPaths() {
  // /src/assets/episodes 안의 원문 HTML 전부 스캔 ( (1) 파일까지 포함 )
  const maps = import.meta.glob('/src/assets/episodes/episode_*_inline_light_v3*.html');

  const nums = Object.keys(maps)
    .map((p) => p.match(/episode_(\d+)_inline_light_v3/)?.[1])
    .filter(Boolean);

  const uniq = Array.from(new Set(nums)).sort((a, b) => Number(a) - Number(b));
  return uniq.map((num) => ({ params: { num } }));
}

const num = Astro.params.num!.padStart(2, '0');

// 문자열로 로드
const rawMaps = import.meta.glob('/src/assets/episodes/episode_*_inline_light_v3*.html', { as: 'raw' });
const key    = `/src/assets/episodes/episode_${num}_inline_light_v3.html`;
const keyAlt = `/src/assets/episodes/episode_${num}_inline_light_v3 (1).html`;

let raw = '';
if (rawMaps[key])      raw = await rawMaps[key]!();
else if (rawMaps[keyAlt]) raw = await rawMaps[keyAlt]!();
else throw new Error(`[episodes/${num}] 원문을 찾을 수 없어요: ${key}`);

// body만 추출(있으면)
if (/<body[\s\S]*?>/i.test(raw)) {
  raw = raw.replace(/^[\s\S]*?<body[^>]*>/i, '').replace(/<\/body>[\s\S]*$/i, '');
}
// 빈 문단/연갈이 정리
raw = raw.replace(/<p[^>]*>\s*<\/p>/gi, '<p></p>');
raw = raw.replace(/<\/p>\s*\n\s*\n\s*<p/gi, '</p>\n<p></p>\n<p');

const title = `에피소드 ${num}`;
const subtitle = '';
const html = `<div class="ep-raw">${raw}</div>`;
---

<EpisodeLayout {title} {subtitle}>
  <div set:html={html} />
</EpisodeLayout>

