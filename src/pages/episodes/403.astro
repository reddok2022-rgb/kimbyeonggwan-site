---
import { yusilEpisodes } from "../../data/yusilEpisodes";

const EP_ID = 403; // URL 번호와 맞추기

// id === 403 인 에피소드 찾기
const ep = yusilEpisodes.find((e) => e.id === EP_ID);
if (!ep) {
  throw new Error(`유실 ${EP_ID}화를 찾을 수 없습니다.`);
}

// parsePoem 에서 만들어 준 연 배열
const stanzas = ep.stanzas;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <title>{ep.title}</title>
  </head>

  <body>
    <!-- 모달에서 이 .ep-wrap 안쪽만 가져다 씀 -->
    <div class="ep-wrap yusil-wrap">
      <div class="poem">
        {
          stanzas.map((stanza) => (
            <p class="poem-stanza">
              {
                stanza.map((line) => (
                  <span class="poem-line">
                    {line}
                  </span>
                ))
              }
            </p>
          ))
        }
      </div>
    </div>
  </body>
</html>
