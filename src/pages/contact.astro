---
/* src/pages/contact.astro */
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Contact</title>

    <style>
      :root {
        --bg: #05070a;
        --fg: #ececec;
        --muted: #9aa3b4;
        --accent: #da6767;
        --maxw: 1120px;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: Pretendard, "Noto Sans KR", system-ui, -apple-system,
          "Segoe UI", Roboto, Helvetica, Arial, "Apple SD Gothic Neo",
          "Noto Sans", "Malgun Gothic", sans-serif;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .topbar-wrap {
        border-bottom: 1px solid var(--accent);
        background: #000;
      }
      .topbar {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 10px 20px 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 13px;
      }
      .topbar-link {
        color: #cbd2e3;
      }
      .topbar-link:hover {
        color: #ffffff;
      }
      .topbar-center {
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .contact-page {
        max-width: 960px;
        margin: 48px auto 80px;
        padding: 0 20px;
        text-align: center;
      }

      .contact-page h1 {
        margin: 0 0 28px;
        font-size: 40px;
        letter-spacing: -0.02em;
        color: #e9edf7;
      }

      .contact-figure {
        margin: 0 auto 32px;
        max-width: 420px;
      }

      .contact-figure img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 4px;
        box-shadow: 0 22px 60px rgba(0, 0, 0, 0.7);
      }

      .contact-list {
       display: flex;
       flex-direction: column;
       gap: 10px;
       align-items: flex-start;   /* 항목 안에서는 왼쪽 정렬 */
       width: fit-content;        /* 내용만큼만 너비 */
       margin: 0 auto;            /* 묶음 자체를 가운데로 */
      }

      .contact-item {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 15px;
        letter-spacing: -0.01em;
        color: #cbd2e3;
        cursor: pointer;
        text-decoration: none;
        transition: color 0.18s ease-out, transform 0.18s ease-out;
      }

      .contact-item:hover {
        color: #da6767;
        transform: translateY(-1px);
      }

      .contact-icon {
        width: 18px;
        height: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .contact-icon svg {
        width: 18px;
        height: 18px;
        stroke: currentColor;
        fill: none;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      @media (max-width: 640px) {
        .contact-page {
          margin-top: 36px;
          padding: 0 18px 60px;
        }
        .contact-page h1 {
          font-size: 32px;
        }
        .contact-figure {
          max-width: 340px;
        }
      }
    </style>
  </head>

  <body>
    <div class="topbar-wrap">
      <header class="topbar">
        <a href="/intro" class="topbar-link">Intro</a>
        <div class="topbar-center">Contact</div>
        <a href="/series" class="topbar-link">Series</a>
      </header>
    </div>

    <main class="contact-page">

      <figure class="contact-figure">
        <img
          src="/assets/contact-illustration.png"
          alt="Contact illustration"
          loading="lazy"
        />
      </figure>

      <div class="contact-list">
        <!-- Email -->
        <a class="contact-item" href="mailto:comfortvelocity@naver.com">
          <span class="contact-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" ry="2" />
              <polyline points="4 6 12 12 20 6" />
            </svg>
          </span>
          <span>comfortvelocity@naver.com</span>
        </a>

        <!-- Instagram -->
        <a
          class="contact-item"
          href="https://www.instagram.com/melonanearme"
          target="_blank"
          rel="noreferrer"
        >
          <span class="contact-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" ry="5" />
              <circle cx="12" cy="12" r="5" />
              <circle cx="17" cy="7" r="1.4" />
            </svg>
          </span>
          <span>@melonanearme</span>
        </a>
      </div>
    </main>
  </body>
</html>
