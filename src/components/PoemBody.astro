---
// src/components/PoemBody.astro
import type { PoemLine } from "../utils/parsePoem";

const { lines } = Astro.props as { lines: PoemLine[] };
---

<style>
  /* 가우시안 블러 모달의 .ep-wrap 과 최대한 맞춘다 */
  .poem-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 4px 24px;
    font-family: Pretendard, "Noto Sans KR", system-ui, -apple-system,
      "Segoe UI", Roboto, Helvetica, Arial, "Apple SD Gothic Neo",
      "Noto Sans", "Malgun Gothic", sans-serif;
    font-size: 16px;
    line-height: 1.14;
    letter-spacing: -0.01em;
    color: #eee;
  }

  .poem-line {
    margin: 0 0 0.35em 0;
  }

  /* 새 연의 첫 줄만 위쪽 여백 추가 = 연갈이 간격 */
  .poem-line.stanza-start {
    margin-top: 1.4em;
  }

  @media (max-width: 480px) {
    .poem-wrap {
      font-size: 17px;
      line-height: 1.38;
      padding: 0 2px 22px;
    }
    .poem-line {
      word-break: keep-all;
    }
    .poem-line.stanza-start {
      margin-top: 1.2em;
    }
  }
</style>

<div class="poem-wrap">
  {lines.map((line) => (
    <p
      class={`poem-line${line.stanzaStart ? " stanza-start" : ""}`}
    >
      {line.text}
    </p>
  ))}
</div>
